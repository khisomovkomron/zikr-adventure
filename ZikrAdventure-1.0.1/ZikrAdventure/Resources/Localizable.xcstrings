    "auth.reauth" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in again to confirm account deletion."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунтты жоюды растау үшін қайта кіріңіз."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунтту өчүрүүнү ырастоо үчүн кайра кириңиз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы удалить аккаунт, подтвердите вход ещё раз."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Барои тасдиқи нест кардани ҳисоб дубора ворид шавед."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hisobni o‘chirishni tasdiqlash uchun yana kirish talab qilinadi."
          }
        }
      }
    },
    "auth.retry" : {
      "extractionState" : "manual",
      "localizations" : {
