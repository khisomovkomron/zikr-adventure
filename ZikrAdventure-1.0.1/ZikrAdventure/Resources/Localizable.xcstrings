    "auth.error" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not sign in. Please try again."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кіру мүмкін болмады. Қайта көріңіз."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кирүү мүмкүн болгон жок. Кайра аракет кылыңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось войти. Попробуйте ещё раз."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ворид шудан муяссар нашуд. Боз кӯшиш кунед."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirish amalga oshmadi. Yana urinib ko‘ring."
          }
        }
      }
    },
