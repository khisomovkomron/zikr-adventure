    },
    "auth.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with Google or Apple. You can use the counter without an account."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google немесе Apple арқылы кіріңіз. Санауышты аккаунтсыз пайдалануға болады."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google же Apple аркылуу кириңиз. Эсептегичти аккаунтсуз колдонсоңуз болот."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите через Google или Apple. Счётчиком можно пользоваться без аккаунта."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бо Google ё Apple ворид шавед. Ҳисобкунакро бе ҳисоб ҳам истифода бурдан мумкин аст."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google yoki Apple orqali kiring. Hisoblagichni hisob ochmasdan ham ishlatish mumkin."
          }
        }
      }
    },
    "auth.loading" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
