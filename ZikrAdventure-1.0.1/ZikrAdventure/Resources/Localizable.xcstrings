    "auth.delete" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete account"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунтты жою"
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунтту өчүрүү"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить аккаунт"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нест кардани ҳисоб"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hisobni o‘chirish"
          }
        }
      }
    },
    "auth.deleteBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account will be deleted. Your count and history will stay on this device. To remove them, reset your progress in Settings."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунтыңыз жойылады. Есеп пен тарих құрылғыда қалады. Оларды жою үшін баптауларда прогресті тазалаңыз."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунтуңуз өчүрүлөт. Эсеп жана тарых түзмөктө калат. Аларды өчүрүү үчүн жөндөөлөрдө прогрессти тазалаңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учётная запись будет удалена. Счёт и история на устройстве сохранятся. Для их удаления используйте сброс прогресса в настройках."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳисоби корбар нест карда мешавад. Ҳисобкунак ва таърих дар дастгоҳ мемонанд. Барои нест кардани онҳо пешрафтро дар танзимот тоза кунед."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foydalanuvchi hisobi o‘chiriladi. Hisoblagich va tarix qurilmada qoladi. Ularni o‘chirish uchun sozlamalarda natijani tozalang."
          }
        }
      }
    },
