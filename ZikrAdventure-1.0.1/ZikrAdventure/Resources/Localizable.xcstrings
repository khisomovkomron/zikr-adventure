    "a11y.button" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zikr button. Increase the counter by one"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зікір түймесі. Санауышты біреуге арттыру"
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зикир баскычы. Эсептегичти бирге көбөйтүү"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка зикра. Увеличить счётчик на один"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тугмаи зикр. Ҳисобро як адад зиёд кардан"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zikr tugmasi. Hisobni bittaga oshirish"
          }
        }
      }
    },
