    "set.langNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzbek, Tajik, Kazakh and Kyrgyz translations need review by native speakers."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өзбек, тәжік, қазақ және қырғыз аудармаларын ана тілінде сөйлейтіндер тексеруі керек."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өзбек, тажик, казак жана кыргыз котормолорун эне тилинде сүйлөгөндөр текшериши керек."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переводы на узбекский, таджикский, казахский и кыргызский требуют вычитки носителями языка."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тарҷумаҳои ӯзбекӣ, тоҷикӣ, қазоқӣ ва қирғизӣ бояд аз ҷониби соҳибзабонон санҷида шаванд."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O‘zbek, tojik, qozoq va qirg‘iz tarjimalari ona tili sohiblari tomonidan tekshirilishi kerak."
          }
        }
      }
    },
