    "zikr.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The count is only a personal record and a way to walk the Sira path. It is not a measure of spiritual worth."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Санауыш — тек жеке жазба және Сира жолымен жүру тәсілі. Ол рухани құндылықтың өлшемі емес."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эсептегич — жөн гана жеке жазуу жана Сира жолу менен жүрүү ыкмасы. Ал рухий баалуулуктун ченеми эмес."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Счётчик — лишь личная запись и способ идти по пути Сиры. Это не мера духовной ценности."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳисобкунак танҳо сабти шахсӣ ва василаи рафтан дар роҳи Сийра аст. Он меъёри арзиши маънавӣ нест."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hisoblagich — shaxsiy qayd va Siyrat yo‘lidan yurish vositasi, xolos. U ma’naviy qadr o‘lchovi emas."
          }
        }
      }
    },
