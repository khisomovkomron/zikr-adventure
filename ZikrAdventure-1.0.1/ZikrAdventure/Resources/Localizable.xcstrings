    "city.mecca.sum" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A city in a rocky valley among the Hejaz mountains. The Kaaba, Safa and Marwa, homes of the first Muslims, the caves of Hira and Thawr."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хиджаз таулары арасындағы тасты аңғардағы қала. Қағба, Сафа мен Мәруа, алғашқы мұсылмандардың үйлері, Хира және Саур үңгірлері."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хиджаз тоолорунун арасындагы таштуу өрөөндөгү шаар. Кааба, Сафа жана Марва, алгачкы мусулмандардын үйлөрү, Хира жана Саур үңкүрлөрү."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Город в каменистой долине среди гор Хиджаза. Кааба, Сафа и Марва, дома первых мусульман, пещеры Хира и Саур."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаҳре дар водии санглох миёни кӯҳҳои Ҳиҷоз. Каъба, Сафо ва Марва, хонаҳои мусулмонони аввал, ғорҳои Ҳиро ва Савр."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hijoz tog‘lari orasidagi toshloq vodiydagi shahar. Ka’ba, Safo va Marva, ilk musulmonlar uylari, Hiro va Savr g‘orlari."
          }
        }
      }
    },
    "city.medina" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medina"
          }
        },
        "kk" : {
