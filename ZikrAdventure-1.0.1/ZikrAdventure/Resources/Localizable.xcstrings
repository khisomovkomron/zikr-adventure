    "zikr.translation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“I ask Allah for forgiveness”"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Алладан кешірім сұраймын»"
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Аллахтан кечирим сурайм»"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Прошу у Аллаха прощения»"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Аз Аллоҳ омурзиш металабам»"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Allohdan mag‘firat so‘rayman»"
          }
        }
      }
