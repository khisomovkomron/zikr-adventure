    "history.confirmM" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records of previous days will be deleted. Your total stays unchanged."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өткен күндердің жазбалары жойылады. Жалпы есеп өзгермейді."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өткөн күндөрдүн жазуулары өчүрүлөт. Жалпы эсеп өзгөрбөйт."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи прошлых дней будут удалены. Общий счёт не изменится."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сабтҳои рӯзҳои гузашта нест мешаванд. Ҳисоби умумӣ тағйир намеёбад."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O‘tgan kunlar yozuvlari o‘chiriladi. Umumiy hisob o‘zgarmaydi."
          }
        }
      }
    },
