    "path.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chapters follow the events of the Prophet’s ﷺ life. Sacred places are always visible and open on the map — along the path the Sira stories open and the city around them comes alive."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тараулар Пайғамбар ﷺ өміріндегі оқиғалар ретімен жүреді. Қасиетті орындар картада әрдайым көрінеді және ашық — жол бойы Сира әңгімелері ашылып, айналадағы қала жанданады."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бөлүмдөр Пайгамбар ﷺ өмүрүндөгү окуялардын тартибинде. Ыйык жерлер картада дайыма көрүнөт жана ачык — жол боюу Сира аңгемелери ачылып, айланадагы шаар жанданат."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главы идут в порядке событий жизни Пророка ﷺ. Священные места видны и доступны на карте всегда — по мере пути открываются рассказы Сиры и оживает город вокруг них."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бобҳо бо тартиби рӯйдодҳои ҳаёти Паёмбар ﷺ меоянд. Ҷойҳои муқаддас дар харита ҳамеша намоён ва кушодаанд — дар роҳ ҳикояҳои Сийра кушода мешаванд ва шаҳри атроф зинда мегардад."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boblar Payg‘ambar ﷺ hayoti voqealari tartibida. Muqaddas joylar xaritada doim ko‘rinadi va ochiq — yo‘l davomida Siyrat hikoyalari ochiladi, atrofdagi shahar jonlanadi."
          }
        }
      }
    },
