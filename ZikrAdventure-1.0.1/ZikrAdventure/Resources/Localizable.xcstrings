    "card.siraLocked" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Sira story opens at %1$@ repetitions. Information about the place is always available."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сираның бұл әңгімесі %1$@ қайталауда ашылады. Орын туралы мәлімет әрдайым қолжетімді."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сиранын бул аңгемеси %1$@ кайталоодо ачылат. Жер тууралуу маалымат дайыма жеткиликтүү."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот рассказ Сиры откроется на %1$@ повторениях. Сведения о месте доступны всегда."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ин ҳикояи Сийра дар %1$@ такрор кушода мешавад. Маълумот дар бораи ҷой ҳамеша дастрас аст."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siyratning bu hikoyasi %1$@ takrorda ochiladi. Joy haqidagi ma’lumot doim ochiq."
          }
        }
      }
    },
