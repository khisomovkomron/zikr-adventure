    "auth.local" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your count and history stay on this device. Signing in does not include cloud backup yet."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есеп пен тарих осы құрылғыда сақталады. Кіру әзірше бұлтта сақтауды қамтымайды."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эсеп жана тарых ушул түзмөктө сакталат. Кирүү азырынча булутта сактоону камтыбайт."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Счёт и история хранятся на этом устройстве. Вход пока не включает облачное сохранение."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳисоб ва таърих дар ҳамин дастгоҳ нигоҳ дошта мешаванд. Воридшавӣ ҳоло нигоҳдорӣ дар абрро дар бар намегирад."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hisob va tarix shu qurilmada saqlanadi. Kirish hozircha bulutda saqlashni o‘z ichiga olmaydi."
          }
        }
      }
    },
    "auth.offline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An internet connection is needed to sign in. The counter works offline."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кіру үшін интернет қажет. Санауыш интернетсіз жұмыс істейді."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кирүү үчүн интернет керек. Эсептегич интернетсиз иштейт."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для входа нужен интернет. Счётчик доступен без сети."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Барои воридшавӣ интернет лозим аст. Ҳисобкунак бе интернет кор мекунад."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirish uchun internet kerak. Hisoblagich internetsiz ishlaydi."
          }
        }
      }
    },
