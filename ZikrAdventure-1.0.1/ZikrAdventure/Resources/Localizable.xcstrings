    "city.medina.sum" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An oasis of palm groves between lava fields. The Prophet’s ﷺ Mosque, Quba, al-Qiblatayn, al-Baqi and Mount Uhud."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лава алқаптары арасындағы құрмалы оазис. Пайғамбар ﷺ мешіті, Құба, әл-Қыблатайн, әл-Бақиъ және Ұхуд тауы."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лава талааларынын арасындагы курмалуу оазис. Пайгамбар ﷺ мечити, Куба, аль-Кыблатайн, аль-Бакиъ жана Ухуд тоосу."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оазис с пальмовыми рощами между лавовыми полями. Мечеть Пророка ﷺ, Куба, аль-Кыблатайн, аль-Баки и гора Ухуд."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воҳаи нахлзор миёни майдонҳои гудоза. Масҷиди Паёмбар ﷺ, Қубо, ал-Қиблатайн, ал-Бақеъ ва кӯҳи Уҳуд."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lava dalalari orasidagi xurmozor voha. Payg‘ambar ﷺ masjidi, Quba, al-Qiblatayn, al-Baqi’ va Uhud tog‘i."
          }
        }
      }
    },
