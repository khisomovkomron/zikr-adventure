    "auth.accountExists" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An account with this email already exists. Sign in using the method you used the first time."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осы email мекенжайымен аккаунт әлдеқашан бар. Бірінші рет пайдаланған әдісті қолданып кіріңіз."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бул email дарегинен аккаунт мурунтан эле бар. Биринчи жолу колдонгон ыкма менен кириңиз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт с этим адресом уже существует. Войдите через тот способ, который использовали первый раз."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бо ин суроғаи email ҳисоб аллакай вуҷуд дорад. Бо тарзе ворид шавед, ки аввалин маротиба истифода бурдаед."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu manzil bilan hisob allaqachon mavjud. Birinchi marta ishlatgan yo‘lingiz bilan kiring."
          }
        }
      }
    },
