    "set.statsFoot" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A goal is optional. Missing a day is fine — nothing is lost."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мақсат міндетті емес. Бір күнді өткізіп алу — қалыпты жағдай, ештеңе жоғалмайды."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максат милдеттүү эмес. Бир күндү өткөрүп жиберүү — кадимки нерсе, эч нерсе жоголбойт."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цель необязательна. Пропустить день — нормально, ничего не теряется."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ҳадаф ихтиёрӣ аст. Як рӯзро гузаронидан муқаррарист — чизе гум намешавад."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maqsad ixtiyoriy. Bir kunni o‘tkazib yuborish — normal, hech narsa yo‘qolmaydi."
          }
        }
      }
    },
