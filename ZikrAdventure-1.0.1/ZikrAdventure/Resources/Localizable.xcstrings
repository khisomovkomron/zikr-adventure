    "card.lookNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruction based on historical descriptions. The map image is an artistic stylization."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тарихи сипаттамалар бойынша қайта жаңғырту. Картадағы бейне — көркем стильдендіру."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тарыхый сүрөттөмөлөр боюнча калыбына келтирүү. Картадагы сүрөт — көркөм стилдештирүү."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реконструкция по историческим описаниям. Изображение на карте — художественная стилизация."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Барқарорсозӣ аз рӯи тавсифҳои таърихӣ. Тасвири харита — услубсозии бадеӣ."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarixiy tasvirlar asosidagi rekonstruksiya. Xaritadagi tasvir — badiiy uslublashtirish."
          }
        }
      }
    },
